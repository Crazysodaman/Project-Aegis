{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/contracts/ipc/v1/stop-status.schema.json",
  "title": "Aegis Safe STOP status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "active", "revision", "updated_at", "updated_by", "reason"],
  "properties": {
    "schema": { "const": "aegis.safe.stop_status.v1" },
    "active": { "type": "boolean" },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string", "minLength": 1 },
    "updated_by": { "type": "string", "minLength": 1, "maxLength": 128 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
